# Copy to /etc/larva-php/larva-php.env (or /etc/larva-php/<instance>.env
# when using larva-php@.service) and adjust for your application.
#
# Systemd expands ${VAR} in ExecStart; keep these names unchanged.

# Document root served by LarvaPHP (must be readable by www-data).
LARVA_ROOT=/var/www/larvaphp/public

# TCP address, also used as the HTTP/3 (UDP) address.
# Use 0.0.0.0:80 or similar for a public service (CAP_NET_BIND_SERVICE is
# already granted in the unit file).
LARVA_ADDR=127.0.0.1:8000

# 0 = single process (recommended for embedded PHP).
# >0 starts N isolated worker processes (each with its own PHP instance).
LARVA_WORKERS=0

# HTTP/3 TLS certificate/key. Parent directory must already exist and be
# writable by www-data; a self-signed cert is generated if files are missing.
LARVA_CERT=/var/lib/larva-php/tls/cert.pem
LARVA_KEY=/var/lib/larva-php/tls/key.pem
